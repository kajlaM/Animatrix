# Animatrix Environment Configuration Example
# Duplicate this file as .env and fill in the values

# Required: Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Required: Secret key for signing JWT tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=YOUR_GENERATED_HEX_SECRET_KEY_HERE

# Server configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Manim rendering quality ('l' for 480p, 'm' for 720p, 'h' for 1080p)
MANIM_QUALITY=m

# Optional: Google OAuth Client ID for Google Single Sign-On
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

